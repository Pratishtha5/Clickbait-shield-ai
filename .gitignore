# ==========================================
# ClickBait Shield AI - .gitignore
# ==========================================

# --- Python Cache & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Data & Machine Learning Artifacts ---
# Local datasets, weights, and cached models
/data/
*.joblib
*.pkl
*.pickle
*.h5
*.pt
*.pth
*.onnx

# --- Environment Variables & Secrets ---
.env
.env.*
!.env.example

# --- IDEs & Code Editors ---
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/
.history/

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Logs & Runtime ---
*.log
logs/
*.sqlite
*.sqlite3
*.db
tmp/
temp/

# --- Testing & Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# --- Jupyter Notebooks ---
.ipynb_checkpoints
*-checkpoint.html

# --- Distribution & Builds ---
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Chrome Extension Builds & Secrets ---
*.crx
*.pem
node_modules/
